rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alfaajmc@gmail.com' ||
        request.auth.token.email == 'ac926815124@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isVerified(userId) {
      return isSignedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/public_profiles/$(userId)).data.isVerified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'firstName', 'lastName', 'email']) 
        && data.id == request.auth.uid
        && data.firstName is string && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() <= 100
        && data.email is string
        && (request.auth.token.email == null || data.email.lower() == request.auth.token.email.lower())
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 100))
        && (!('birthDate' in data) || data.birthDate is number)
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 6000))
        && (!('balance' in data) || data.balance is number)
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('isAdmin' in data) || data.isAdmin == false || isAdmin() || data.email == 'alfaajmc@gmail.com' || data.email == 'ac926815124@gmail.com');
    }

    function isValidPublicUser(data) {
      return data.keys().hasAll(['id', 'firstName', 'lastName'])
        && data.id is string
        && data.firstName is string && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() <= 100
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 5000))
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeen' in data) || data.lastSeen is number);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'timestamp', 'authorName'])
        && (data.userId == request.auth.uid || (isAdmin() && data.userId == 'system'))
        && data.type in ['TEXT', 'IMAGE', 'VIDEO', 'LIVE', 'REEL']
        && data.timestamp is number
        && data.authorName is string && data.authorName.size() <= 128
        && (!('content' in data) || (data.content is string && data.content.size() <= 10000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (!('isAnonymous' in data) || data.isAnonymous is bool);
    }

    function isValidBlock(data) {
      return data.keys().hasAll(['blockerId', 'blockedId', 'timestamp'])
        && data.blockerId == request.auth.uid
        && data.blockedId is string && data.blockedId.size() <= 128
        && (data.timestamp is number || data.timestamp == request.time);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'timestamp', 'status'])
        && data.userId == request.auth.uid
        && data.amount is number
        && data.type in ['DEPOSIT', 'WITHDRAWAL', 'PURCHASE', 'SALE', 'CHAT_FEE', 'BOOST', 'DONATION', 'TICKET', 'REFUND', 'PLATFORM_FEE']
        && (data.timestamp is number || data.timestamp == request.time);
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth.token.email == 'alfaajmc@gmail.com' || request.auth.token.email == 'ac926815124@gmail.com';
    }

    // Affiliate Links
    match /affiliate_links/{linkId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.affiliateId || request.auth.uid == resource.data.sellerId || isAdmin());
      allow create: if isSignedIn() && (incoming().affiliateId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- Rules ---

    // Profiles
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && (
          // Case 1: Full profile update (requires validation)
          (incoming().diff(existing()).affectedKeys().hasAny(['firstName', 'lastName', 'email']) && isValidUser(incoming()) && 
            incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'phone', 'bio', 'profilePicture', 'coverPhoto', 
              'gender', 'birthDate', 'country', 'address', 'lastSeen', 'isOnline', 
              'followedUsers', 'followers', 'blockedUserIds', 'idVerificationStatus', 
              'idVerificationDocs', 'academicRole', 'updatedAt', 'documentId', 'email',
              'userType', 'monetizationGoals', 'monetizationStatus', 'isVerified', 'monetizationTier',
              'balance', 'pendingBalance', 'totalEarnings', 'isMonetized', 'isFrozen',
              'creatorStats', 'isPremium', 'premiumExpiry', 'resellerName', 'resellerBio', 'resellerBanner',
              'storeId', 'isSuspended', 'verificationFileUrl', 'totalWithdrawn', 'id', 'createdAt', 'timestamp'
            ])) ||
          // Case 2: Partial update (don't force full validation if owner)
          (!incoming().diff(existing()).affectedKeys().hasAny(['firstName', 'lastName', 'email']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'phone', 'bio', 'profilePicture', 'coverPhoto', 
              'gender', 'birthDate', 'country', 'address', 'lastSeen', 'isOnline', 
              'followedUsers', 'followers', 'blockedUserIds', 'idVerificationStatus', 
              'idVerificationDocs', 'academicRole', 'updatedAt', 'documentId', 'email',
              'userType', 'monetizationGoals', 'monetizationStatus', 'isVerified', 'monetizationTier',
              'balance', 'pendingBalance', 'totalEarnings', 'isMonetized', 'isFrozen',
              'creatorStats', 'isPremium', 'premiumExpiry', 'resellerName', 'resellerBio', 'resellerBanner',
              'storeId', 'isSuspended', 'verificationFileUrl', 'totalWithdrawn', 'id', 'createdAt', 'timestamp'
            ]))
        ) && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin']) || isAdmin())
        ) ||
        // Allow others to update balance fields, monetizationStatus, presence and follow stats during follows/transactions/donations/sales
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'pendingBalance', 'totalEarnings', 'followedUsers', 'followers', 'creatorStats', 'monetizationStatus', 'isOnline', 'lastSeen', 'monetizationGoals']))
      ));
      allow delete: if isAdmin();
    }

    // Public Profiles
    match /public_profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidPublicUser(incoming());
      allow update: if (isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly([
            'firstName', 'lastName', 'profilePicture', 'coverPhoto', 'bio', 'isVerified', 
            'isOnline', 'followedUsers', 'followers', 'idVerificationStatus', 'balance', 
            'monetizationStatus', 'lastSeen', 'userType', 'address', 'monetizationGoals', 'academicRole',
            'id', 'createdAt', 'isSuspended', 'isFrozen', 'isPremium', 'birthDate', 'country',
            'updatedAt', 'timestamp', 'isMonetized', 'monetizationTier', 'blockedUserIds', 'isAdmin'
          ]) && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin']) || isAdmin())
        ) ||
        // Allow others to update balance, presence, follow stats, and monetization status during follows/transactions
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'isOnline', 'lastSeen', 'followers', 'followedUsers', 'monetizationStatus', 'creatorStats']))
      ));
      allow delete: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly([
          'content', 'imageUrl', 'isPinned', 'disableComments', 'isMonetized', 'isAnonymous', 
          'liveStream', 'liveChat', 'liveViewerCount', 'liveHeartCount', 'likes', 'comments', 
          'shares', 'reactions', 'views', 'saves', 'indicatedUserIds', 'liveViewersMap'
        ])) ||
        (!isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly([
          'likes', 'comments', 'shares', 'reactions', 'views', 'saves', 'indicatedUserIds',
          'liveChat', 'liveViewerCount', 'liveHeartCount', 'liveStream', 'liveViewersMap'
        ]))
      );
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Uniqueness Registry
    match /uniqueness_registry/{registryId} {
      allow get: if true; // Allow checking availability before sign-up
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || (existing().userId == request.auth.uid && incoming().userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Chats
    match /chats/{chatId} {
      allow get: if (resource.data.isPublic == true) || (isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participants));
      allow list: if (resource.data.isPublic == true) || (isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participants));
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid in incoming().participants || incoming().isPublic == true);
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == existing().adminId) ||
        (request.auth.uid in existing().participants && (
          incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'description', 'theme', 'groupName', 'groupImage', 'participants'])
        )) ||
        (incoming().isPublic == true && incoming().diff(existing()).affectedKeys().hasOnly(['participants'])) // Allow joining public chats
      );
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(notificationId) && (
        (incoming().actorId == request.auth.uid && incoming().recipientId != request.auth.uid)
        || (incoming().actorId in ['SYSTEM', 'SYSTEM_AD'] && incoming().recipientId == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidId(notificationId) && (resource.data.recipientId == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && isValidId(notificationId) && (
        resource.data.recipientId == request.auth.uid 
        || resource.data.actorId == request.auth.uid
        || isAdmin()
      );
    }

    // Ads
    match /ads/{adId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || isOwner(existing().userId);
    }

    // Stores & Products
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'productIds', 'brandColor']));
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(productId) && exists(/databases/$(database)/documents/stores/$(incoming().storeId)) && get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/stores/$(existing().storeId)) && 
          get(/databases/$(database)/documents/stores/$(existing().storeId)).data.userId == request.auth.uid && 
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'price', 'imageUrls', 'status', 'stock', 'type', 'category',
            'condition', 'brand', 'sku', 'videoUrl', 'attributes', 'variants',
            'hasFreeShipping', 'shippingFee', 'positioning', 'bidAmount',
            'lessonsCount', 'totalHours', 'hasCertificate', 'modules',
            'weight', 'dimensions', 'digitalContentUrl', 'affiliateCommissionRate',
            'originalPrice', 'discountPercentage', 'updatedAt'
          ])
        ) ||
        // Allow buyers to update sold count
        (incoming().diff(existing()).affectedKeys().hasOnly(['soldCount', 'ratings', 'averageRating', 'ratingCount']))
      );
      allow delete: if isAdmin() || (exists(/databases/$(database)/documents/stores/$(existing().storeId)) && get(/databases/$(database)/documents/stores/$(existing().storeId)).data.userId == request.auth.uid);
    }

    // Transactions (Strict but allowing creation)
    match /transactions/{transactionId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update, delete: if isAdmin();
    }

    // Sales
    match /sales/{saleId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.affiliateUserId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(incoming().buyerId) || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(existing().buyerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isRated', 'rating', 'ratingComment', 'disputeReason', 'fundsReleased', 'updatedAt', 'canceledAt', 'refundAmount', 'cancellationFee'])) ||
        (isOwner(existing().sellerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingCode', 'supplierOrderId', 'fundsReleased', 'updatedAt', 'fundsReleasedAt']))
      );
      allow delete: if isOwner(existing().buyerId) || isOwner(existing().sellerId) || isAdmin();
    }

    // Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isOwner(incoming().userId) && incoming().timestamp is number;
      allow update: if isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['views']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Tickets
    match /tickets/{ticketId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isOwner(incoming().userId);
      allow update: if isOwner(existing().userId) || isAdmin();
    }

    // Blocks
    match /blocks/{blockId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId || isAdmin());
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(blockId) && isValidBlock(incoming());
      allow delete: if isSignedIn() && (existing().blockerId == request.auth.uid || isAdmin());
    }

    // Earnings
    match /earnings/{recordId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.creatorId || isAdmin());
      allow write: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Super Chats
    match /super_chats/{chatId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Logs
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Calls
    match /calls/{callId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().callerId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
    }
  }
}
